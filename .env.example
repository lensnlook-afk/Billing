# Generate a 32+ character random value: openssl rand -base64 48
# Supabase: copy the Transaction pooler URI from Connect > ORMs and use sslmode=require.
# Example: postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://clarity:change-me@localhost:5432/clarity
DATABASE_SSL=false
SESSION_SECRET=replace-this-with-a-long-random-secret
PORT=3001
WEB_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# Used exactly once by `npm run bootstrap-owner --workspace=@clarity/api`.
# Put real values in your secret manager or untracked .env — never commit them.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_EMPLOYEE_USERNAME=employee
BOOTSTRAP_EMPLOYEE_PASSWORD=
