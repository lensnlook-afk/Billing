{
  "installCommand": "npm install --include=dev --workspaces",
  "buildCommand": "npm run build --workspace=@clarity/web && npm run build --workspace=@clarity/api",
  "outputDirectory": "apps/web/dist",
  "framework": null,
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 30,
      "includeFiles": "apps/api/dist/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/[...path]" }
  ]
}
